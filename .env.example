# Copy to .env at repository root for Docker Compose
POSTGRES_USER=mfa
POSTGRES_PASSWORD=mfa
POSTGRES_DB=mfa

# App (async — SQLAlchemy / FastAPI)
DATABASE_URL=postgresql+asyncpg://mfa:mfa@postgres:5432/mfa

# Migrations (sync — Alembic)
DATABASE_URL_SYNC=postgresql+psycopg://mfa:mfa@postgres:5432/mfa

ENV=poc
LOG_LEVEL=INFO
