# =============================================================================
# Root .env — Docker Compose orchestration
# =============================================================================
# Copy to .env at the REPOSITORY ROOT:
#   cp .env.example .env
#
# Used by: docker compose (all services in docker-compose.yml)
# NOT used by: native `uvicorn` on the host — see backend/.env.example instead
#
# Why a root file?
#   Compose automatically loads ./.env for ${VAR} substitution and passes
#   variables into containers. Database hostnames use the Compose service name
#   `postgres`, not `localhost`.
# =============================================================================

POSTGRES_USER=mfa
POSTGRES_PASSWORD=mfa
POSTGRES_DB=mfa

# App (async — SQLAlchemy / FastAPI inside containers)
DATABASE_URL=postgresql+asyncpg://mfa:mfa@postgres:5432/mfa

# Migrations (sync — Alembic inside backend-api container)
DATABASE_URL_SYNC=postgresql+psycopg://mfa:mfa@postgres:5432/mfa

ENV=local
LOG_LEVEL=INFO

# Crawler worker — local evidence artifacts (POC; S3 via S3_EVIDENCE_BUCKET in MVP)
EVIDENCE_DIR=backend/evidence
CRAWL_POLL_INTERVAL_SEC=5
CRAWL_DWELL_SEC=10
CRAWL_DUAL_PERSONA=true
CRAWL_REFERRER_SOURCE=outbrain
# Parallel crawl workers for batch eval (each runs one Playwright job at a time).
# Use: docker compose up -d --scale crawler-worker=${CRAWL_WORKER_REPLICAS}
# Or:  ./scripts/dev/up-stack.sh
CRAWL_WORKER_REPLICAS=3

# Redis cache (MVP-1.6)
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL_SEC=86400

# AWS / LocalStack (optional — profile localstack)
AWS_DEFAULT_REGION=us-east-1
# AWS_ENDPOINT_URL=http://localstack:4566
# S3_EVIDENCE_BUCKET=mfa-dev-evidence

# LLM explanations (MVP-2.4) — disabled by default locally
# BEDROCK_ENABLED=true
# BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Auth (MVP-4.6) — Cognito JWT validation
# MFA_REQUIRE_AUTH=1
# COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
# COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# COGNITO_REGION=us-east-1

# ML worker — scoring artifacts and poll interval
ARTIFACT_DIR=ml/artifacts/v1
SCORE_POLL_INTERVAL_SEC=5

# SQS (MVP-1.3) — enable with LocalStack profile
# AWS_ENDPOINT_URL=http://localstack:4566
# SQS_BATCH_QUEUE_URL=http://localstack:4566/000000000000/mfa-local-batch-queue
# SQS_CRAWL_QUEUE_URL=http://localstack:4566/000000000000/mfa-local-batch-queue
# SQS_SCORE_QUEUE_URL=http://localstack:4566/000000000000/mfa-local-batch-queue
# SQS_PRIORITY_QUEUE_URL=http://localstack:4566/000000000000/mfa-local-priority-queue.fifo

# OpenSearch (MVP-3.1) — optional local or AWS Serverless endpoint
# OPENSEARCH_ENDPOINT=https://<collection-id>.us-east-1.aoss.amazonaws.com
# OPENSEARCH_INDEX=mfa-rag-v1
# INDEX_POLL_INTERVAL_SEC=30

# Shadow mode (MVP-5.1) — score without DSP block enforcement
# MFA_SHADOW_MODE=1
