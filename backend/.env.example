# =============================================================================
# Backend .env — native development on the host
# =============================================================================
# Copy inside the backend package:
#   cp backend/.env.example backend/.env
#
# Used by: `uv run --directory backend uvicorn ...` and Alembic when run from
#          the host (see README "Native development")
# NOT used by: Docker Compose — the backend-api container gets env from the
#              root .env via docker-compose.yml
#
# Why separate from root .env?
#   On the host, Postgres is reached at localhost:5432 (port published from the
#   postgres container). Inside Docker, the hostname is `postgres`. Same creds,
#   different host — two files avoid editing URLs every time you switch modes.
# =============================================================================

ENV=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://mfa:mfa@localhost:5432/mfa
DATABASE_URL_SYNC=postgresql+psycopg://mfa:mfa@localhost:5432/mfa
DATABASE_ECHO=false

# Auth (MVP-4.6)
# MFA_REQUIRE_AUTH=1
# COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
# COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# COGNITO_REGION=us-east-1
