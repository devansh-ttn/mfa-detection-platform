# Copy to .env for native backend development (Postgres via root docker compose)
ENV=poc
LOG_LEVEL=INFO

# Use localhost when running uvicorn on the host; use postgres hostname inside Compose
DATABASE_URL=postgresql+asyncpg://mfa:mfa@localhost:5432/mfa
DATABASE_URL_SYNC=postgresql+psycopg://mfa:mfa@localhost:5432/mfa
DATABASE_ECHO=false
