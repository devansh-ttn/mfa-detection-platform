# =============================================================================
# Crawler .env — optional native / local crawler runs
# =============================================================================
# Copy inside the crawler package (optional):
#   cp crawler/.env.example crawler/.env
#
# Used by: `uv run --package mfa-crawler python -m mfa_crawler.smoke` and
#          future native worker runs. Settings are read via os.getenv in code.
# NOT used by: Docker Compose — crawler-worker gets ENV/LOG_LEVEL/DATABASE_URL
#              from the root .env via docker-compose.yml
#
# Crawler-specific vars only. This file is NOT auto-loaded by Python — export
# variables in your shell, or rely on Docker Compose (root .env) for workers.
# =============================================================================

ENV=local
LOG_LEVEL=INFO

# Playwright
CRAWL_HEADLESS=true
CRAWL_TIMEOUT_MS=30000
# CRAWL_USER_AGENT=MFA-Detection-Crawler/0.1 (+https://github.com/...)
