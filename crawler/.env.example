# =============================================================================
# Crawler .env — optional native / local crawler runs
# =============================================================================
# Export these in your shell before native runs, or rely on Docker Compose
# (root .env) for crawler-worker.
# =============================================================================

ENV=local
LOG_LEVEL=INFO

# Postgres (required for worker and smoke --persist)
# DATABASE_URL=postgresql+asyncpg://mfa:mfa@localhost:5432/mfa

# Evidence artifacts (default: <repo>/backend/evidence)
# EVIDENCE_DIR=backend/evidence

# Worker poll interval when queue is empty (seconds)
# CRAWL_POLL_INTERVAL_SEC=5

# Playwright
CRAWL_HEADLESS=true
CRAWL_TIMEOUT_MS=30000
# CRAWL_USER_AGENT=MFA-Detection-Crawler/0.1 (+https://github.com/...)
