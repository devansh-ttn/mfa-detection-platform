# Empty = same-origin `/api` via Vite dev proxy (recommended for local dev).
VITE_API_URL=

# --- Local dev auth (omit Cognito vars to use role/actor dev login) ---

# --- Deployed MVP (MVP-4.6) — Cognito hosted UI + Bearer JWT ---
# VITE_COGNITO_REGION=us-east-1
# VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
# VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# VITE_COGNITO_REDIRECT_URI=http://localhost:5173

# Docker Compose only — Vite proxy target inside the compose network.
# VITE_PROXY_TARGET=http://backend-api:8000
